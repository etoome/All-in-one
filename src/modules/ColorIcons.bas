Attribute VB_Name = "ColorIcons"
Option Explicit

' Windows GDI code needs VBA7 (Office 2010+, 32- and 64-bit)
Private Type BITMAPINFOHEADER
    biSize As Long
    biWidth As Long
    biHeight As Long
    biPlanes As Integer
    biBitCount As Integer
    biCompression As Long
    biSizeImage As Long
    biXPelsPerMeter As Long
    biYPelsPerMeter As Long
    biClrUsed As Long
    biClrImportant As Long
End Type

Private Type BITMAPINFO
    bmiHeader As BITMAPINFOHEADER
    bmiColors(0 To 3) As Byte
End Type

Private Type GUID
    Data1 As Long
    Data2 As Integer
    Data3 As Integer
    Data4(0 To 7) As Byte
End Type

Private Type PICTDESC
    cbSizeofstruct As Long
    picType As Long
    hBitmap As LongPtr
    hPal As LongPtr
End Type

Private Declare PtrSafe Function CreateCompatibleDC Lib "gdi32" (ByVal hdc As LongPtr) As LongPtr
Private Declare PtrSafe Function CreateDIBSection Lib "gdi32" (ByVal hdc As LongPtr, ByRef pbmi As BITMAPINFO, ByVal iUsage As Long, ByRef ppvBits As LongPtr, ByVal hSection As LongPtr, ByVal dwOffset As Long) As LongPtr
Private Declare PtrSafe Function SelectObject Lib "gdi32" (ByVal hdc As LongPtr, ByVal hObject As LongPtr) As LongPtr
Private Declare PtrSafe Function DeleteDC Lib "gdi32" (ByVal hdc As LongPtr) As Long
Private Declare PtrSafe Function DeleteObject Lib "gdi32" (ByVal hObject As LongPtr) As Long
Private Declare PtrSafe Sub CopyMemoryOut Lib "kernel32" Alias "RtlMoveMemory" (ByVal Destination As LongPtr, ByRef Source As Any, ByVal cbLength As LongPtr)
Private Declare PtrSafe Function OleCreatePictureIndirect Lib "oleaut32.dll" (ByRef pPictDesc As PICTDESC, ByRef riid As GUID, ByVal fOwn As Long, ByRef ppvObj As IPicture) As Long

Private Const ICON_SIZE As Long = 32
Private Const BAR_HEIGHT As Long = 6
Private Const PICTYPE_BITMAP As Long = 1
Private Const NEUTRAL_BAR As Long = &HA6A6A6
Private Const BAR_OUTLINE As Long = &H808080

' getImage callback: never raises; control.Tag selects which copied color to show under its custom icon.
Sub GetApplyColorImage(control As IRibbonControl, ByRef returnedVal)
    Dim barColor As Long
    Dim hasColor As Boolean
    Dim icon As IPictureDisp

    On Error Resume Next
    Select Case control.Tag
        Case "fillcolor"
            hasColor = CopiedFillColor(barColor)
        Case "linestyle"
            hasColor = CopiedLineColor(barColor)
        Case "textcolor"
            hasColor = CopiedTextColor(barColor)
    End Select

    Set icon = BuildColorIcon(control.Tag, barColor, hasColor)
    If Not icon Is Nothing Then Set returnedVal = icon
End Sub

' Returns the build-embedded PNG for this tag with the bar rows showing the copied color, or cleared when none.
Private Function BuildColorIcon(ByVal tag As String, ByVal barColor As Long, ByVal hasColor As Boolean) As IPictureDisp
    Dim pixels() As Byte

    If Not GetBasePixels(tag, pixels) Then Exit Function
    Premultiply pixels
    DrawBar pixels, barColor, hasColor
    Set BuildColorIcon = PictureFromPixels(pixels)
End Function

' Fills pixels() with the bottom-up straight-alpha 32bpp BGRA generated by Build.ps1 for this tag.
Private Function GetBasePixels(ByVal tag As String, ByRef pixels() As Byte) As Boolean
    Dim n As Long
    Dim b64 As String
    Dim raw() As Byte

    On Error Resume Next
    b64 = IconData.BaseIconBase64(tag)
    If Len(b64) = 0 Then Exit Function

    raw = DecodeBase64(b64)
    n = -1
    n = UBound(raw) - LBound(raw) + 1
    If n <> ICON_SIZE * ICON_SIZE * 4 Then Exit Function

    pixels = raw
    GetBasePixels = True
End Function

' MSXML is late-bound so no project reference is needed.
Private Function DecodeBase64(ByVal s As String) As Byte()
    Dim dom As Object
    Dim node As Object

    On Error Resume Next
    Set dom = CreateObject("MSXML2.DOMDocument.6.0")
    If dom Is Nothing Then Set dom = CreateObject("MSXML2.DOMDocument")
    Set node = dom.createElement("b64")
    node.DataType = "bin.base64"
    node.Text = s
    DecodeBase64 = node.nodeTypedValue
End Function

' Wraps a bottom-up 32bpp BGRA buffer in an IPicture via a new DIB section.
Private Function PictureFromPixels(ByRef pixels() As Byte) As IPictureDisp
    Dim bmi As BITMAPINFO
    Dim bits As LongPtr
    Dim hDib As LongPtr
    Dim dstDC As LongPtr
    Dim oldDst As LongPtr

    On Error GoTo CleanUp
    With bmi.bmiHeader
        .biSize = LenB(bmi.bmiHeader)
        .biWidth = ICON_SIZE
        .biHeight = ICON_SIZE
        .biPlanes = 1
        .biBitCount = 32
    End With

    dstDC = CreateCompatibleDC(0)
    If dstDC = 0 Then GoTo CleanUp
    hDib = CreateDIBSection(dstDC, bmi, 0, bits, 0, 0)
    If hDib = 0 Or bits = 0 Then GoTo CleanUp
    oldDst = SelectObject(dstDC, hDib)
    CopyMemoryOut bits, pixels(0), ICON_SIZE * ICON_SIZE * 4

    ' Deselect the bitmap before the picture takes ownership of it.
    SelectObject dstDC, oldDst
    DeleteDC dstDC
    dstDC = 0

    Set PictureFromPixels = PictureFromBitmap(hDib)
    If Not PictureFromPixels Is Nothing Then hDib = 0

CleanUp:
    On Error Resume Next
    If dstDC <> 0 Then
        SelectObject dstDC, oldDst
        DeleteDC dstDC
    End If
    If hDib <> 0 Then DeleteObject hDib
End Function

' getImage expects premultiplied alpha; multiply RGB by alpha and keep the channel so the background stays transparent.
Private Sub Premultiply(ByRef pixels() As Byte)
    Dim i As Long
    Dim ch As Long
    Dim a As Long

    For i = 0 To UBound(pixels) - 3 Step 4
        a = pixels(i + 3)
        For ch = 0 To 2
            pixels(i + ch) = (pixels(i + ch) * a) \ 255
        Next ch
    Next i
End Sub

' DIB rows run bottom-up, so the bar occupies the first BAR_HEIGHT rows; pixels are B,G,R,A.
' The bar is always drawn: the copied color, or gray when none.
Private Sub DrawBar(ByRef pixels() As Byte, ByVal barColor As Long, ByVal hasColor As Boolean)
    Dim x As Long
    Dim y As Long
    Dim offset As Long
    Dim fillColor As Long
    Dim color As Long
    Dim isEdge As Boolean

    If hasColor Then fillColor = barColor Else fillColor = NEUTRAL_BAR

    For y = 0 To BAR_HEIGHT - 1
        For x = 0 To ICON_SIZE - 1
            offset = (y * ICON_SIZE + x) * 4
            isEdge = (y = 0 Or y = BAR_HEIGHT - 1 Or x = 0 Or x = ICON_SIZE - 1)
            If isEdge Then color = BAR_OUTLINE Else color = fillColor
            pixels(offset) = (color \ &H10000) And &HFF
            pixels(offset + 1) = (color \ &H100) And &HFF
            pixels(offset + 2) = color And &HFF
            pixels(offset + 3) = 255
        Next x
    Next y
End Sub

' fOwn=True: on success the picture destroys the HBITMAP when released; on failure the caller still owns it.
Private Function PictureFromBitmap(ByVal hBitmap As LongPtr) As IPictureDisp
    Dim desc As PICTDESC
    Dim iid As GUID
    Dim pic As IPicture

    With iid
        .Data1 = &H7BF80980
        .Data2 = &HBF32
        .Data3 = &H101A
        .Data4(0) = &H8B
        .Data4(1) = &HBB
        .Data4(2) = &H0
        .Data4(3) = &HAA
        .Data4(4) = &H0
        .Data4(5) = &H30
        .Data4(6) = &HC
        .Data4(7) = &HAB
    End With

    desc.cbSizeofstruct = LenB(desc)
    desc.picType = PICTYPE_BITMAP
    desc.hBitmap = hBitmap

    If OleCreatePictureIndirect(desc, iid, True, pic) = 0 Then Set PictureFromBitmap = pic
End Function
